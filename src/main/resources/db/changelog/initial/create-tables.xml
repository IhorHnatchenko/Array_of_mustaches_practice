<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.4.xsd
                   http://www.liquibase.org/xml/ns/dbchangelog-ext
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">

<changeSet id="100225" author="Kseniya">
    <comment>Add table Anime</comment>
    <createTable tableName="Anime">
        <column name="id" autoIncrement="true" type="BIGINT">
            <constraints primaryKey="true" primaryKeyName="anime_pkey"
                         nullable="false"/>
        </column>
        <column name="name" type="VARCHAR(255)"/>
        <column name="max_number_of_seasons" type="INT"/>
        <column name="max_number_of_episodes" type="INT"/>
        <column name="studio" type="VARCHAR(255)"/>
        <column name="description" type="VARCHAR(255)"/>
        <column name="release_year" type="INT"/>
        <column name="genre" type="VARCHAR(255)"/>
    </createTable>

</changeSet>
</databaseChangeLog>